# The compose file builds with the project root as its context, so without this
# every build ships the ~1.9 GB virtual environment to the Docker daemon before
# it starts. The image builds its own dependencies from requirements-portable.txt
# and needs none of this.
.venv/
__pycache__/
*.py[cod]
.DS_Store
.git/

# Mac-only pieces the portable image has no use for.
Install.command
Start Dubbing Studio.command
packaging/
requirements-mac.txt
requirements-quality.txt
test_pipeline.py
test_upgrade.py
*.md

jobs/
models/
output/
*.log
